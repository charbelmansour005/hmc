# Copy to .env.local and fill in. Never commit real values.

# MongoDB Atlas connection string (use a separate database for dev and prod)
MONGODB_URI=

# 32+ random characters, e.g. `openssl rand -base64 48`
SESSION_SECRET=

# The single CMS account, created by `npm run seed`
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Public base URL: canonical and hreflang links between the three languages,
# the sitemap, and links in notification emails
APP_URL=http://localhost:3000

# Vercel Blob (production uploads). When unset, uploads go to ./uploads
BLOB_READ_WRITE_TOKEN=

# Mapbox public token (pk.*) for the "Visit us" map. When unset, a Google map is shown.
# Restrict it to your site URLs in the Mapbox dashboard.
MAPBOX_TOKEN=

# Google Places API (New) key for the "What patients say" reviews section.
# Server-only: never prefix it with NEXT_PUBLIC_. Restrict it to "Places API (New)"
# and cap its daily quota. The Place ID is set in the CMS (Settings). Unset = section hidden.
GOOGLE_PLACES_API_KEY=

# Optional: appointment notification email (CMS-inbox mode). Disabled unless all are set.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
APPOINTMENT_NOTIFY_TO=
